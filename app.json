{
  "expo": {
    "name": "職缺體檢",
    "slug": "job-check-mobile",
    "scheme": "jobcheck",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "允許職缺體檢讀取你選擇的職缺截圖，用於本機文字辨識與分析。",
          "cameraPermission": "允許職缺體檢拍攝職缺內容，用於本機文字辨識與分析。"
        }
      ],
      "expo-apple-authentication",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/generated/splash-mark.png",
          "imageWidth": 200,
          "backgroundColor": "#FBF6EE",
          "resizeMode": "contain",
          "dark": {
            "image": "./assets/generated/splash-mark.png",
            "backgroundColor": "#FBF6EE"
          }
        }
      ],
      "expo-font",
      "expo-sharing",
      "expo-iap"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lumilab.jobcheck",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.lumilab.jobcheck",
      "adaptiveIcon": {
        "foregroundImage": "./assets/generated/adaptive-foreground.png",
        "backgroundColor": "#FF6B4A"
      }
    },
    "icon": "./assets/generated/app-icon.png",
    "web": {
      "favicon": "./public/icon-192.png"
    }
  }
}
